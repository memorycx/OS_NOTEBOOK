ght":1.25},{"id":"YqdRi5TR","type":"text","x":1865.22,"y":34.34,"w":64,"h":20,"text":"信号状态","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"IHHQFZZu","type":"text","x":1866.04,"y":64.64,"w":64,"h":20,"text":"工作目录","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"7629jGSqRaIlVazhCu_ys","type":"rectangle","x":1848.97,"y":-41.48,"w":153.57,"h":183.88,"color":"#1e1e1e","bg":"transparent","strokeWidth":1,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"g1J6Eb1a","type":"text","x":1850.26,"y":165,"w":240,"h":20,"text":"这些状态并不是简单地逐字节复制","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"LVSIJy6w","type":"text","x":1848.49,"y":185.74,"w":176,"h":20,"text":"具体行为由操作系统规定","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"5rZzjboO","type":"text","x":1681.02,"y":279.8,"w":166.77,"h":20,"text":"子进程拥有不同的 PID","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"Flaa2tME","type":"text","x":1666.96,"y":340.58,"w":429.25,"h":40,"text":"父子进程继承打开的文件描述符，\n通常指向同一个底层打开文件描述（open file description）","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"KMujREU1","type":"text","x":1670.45,"y":310.4,"w":200.34,"h":20,"text":"子进程的 PPID 指向父进程","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"MwnElsnswqp-NzrM5cjSJ","type":"arrow","x":1925.65,"y":147.4,"w":93.08,"h":114.24,"color":"#1e1e1e","strokeWidth":1,"points":[[0,0],[0,57.12],[-93.08,57.12],[-93.08,114.24]],"startArrowhead":null,"endArrowhead":"arrow","strokeStyle":"solid"},{"id":"FRax8MgQXAGtlEmNNDN2f","type":"rectangle","x":1648.56,"y":266.64,"w":472.1,"h":141.56,"color":"#1e1e1e","bg":"transparent","strokeWidth":1,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"OJy0vOd0","type":"text","x":1612.41,"y":448.25,"w":231.48,"h":25,"text":"Q2 : fork返回值是什么？","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"ylvLeZa0","type":"text","x":1662.66,"y":496.41,"w":365.7,"h":25,"text":"fork() 的返回值用于区分父进程和子进程","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"m9gYXHeS","type":"text","x":1732.98,"y":534.32,"w":210.34,"h":20.91,"text":"-1 ： 父进程  -->  创建失败","size":16.73,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"naDrUjDG","type":"text","x":1733.31,"y":566.29,"w":358.41,"h":20.91,"text":"0 ： 子进程  -->  当前执行的是新创建的子进程","size":16.73,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"fIjqd4E3","type":"text","x":1697.01,"y":597.45,"w":364.41,"h":20.91,"text":"正整数 ： 父进程  -->  返回新创建子进程的PID","size":16.73,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"QZ6eMTla","type":"text","x":1718.3,"y":665.41,"w":293.84,"h":475,"text":"#include <stdio.h>\n#include <unistd.h>\n\nint main() {\n\npid_t pid = fork();\n\nif (pid == -1) {\n        printf(\"fork failed\\n\");\n    }\n    else if (pid == 0) {\n        printf(\"I am child\\n\");\n    }\n    else {\n        printf(\"I am parent\\n\");\n    }\n\nreturn 0;\n}","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"oCmTC_5-VqsekNNfZRB65","type":"rectangle","x":1681.96,"y":647.43,"w":359.72,"h":520.02,"color":"#1e1e1e","bg":"transparent","strokeWidth":1,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"bfrWQ_MkMIvfjpoQzhXh0","type":"arrow","x":1861.72,"y":1172.45,"w":0.55,"h":122.5,"color":"#1e1e1e","strokeWidth":1,"points":[[0,0],[0.55,122.5]],"startArrowhead":null,"endArrowhead":"arrow","strokeStyle":"solid"},{"id":"BGl4pNhr","type":"text","x":1749.53,"y":1325.29,"w":100,"h":25,"text":"输出可能：","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"TSStOl46","type":"text","x":1877.68,"y":1321.16,"w":114.1,"h":50,"text":"I am parent\nI am child","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"4QlhjeE1","type":"text","x":1750.11,"y":1397.22,"w":100,"h":25,"text":"输出可能：","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"IM9rz6Ot","type":"text","x":1871.6,"y":1398.17,"w":114.1,"h":50,"text":"I am child\nI am parent","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"scarNyTd","type":"text","x":1706.5,"y":1472.5,"w":380,"h":25,"text":"因为父进程和子进程是两个独立的执行流，","size":20,"color":"#1971c2","align":"left","valign":"top","lineHeight":1.25},{"id":"QVOAq3WG","type":"text","x":1712.57,"y":1506.78,"w":360,"h":25,"text":"操作系统调度它们执行的先后顺序不确定","size":20,"color":"#1971c2","align":"left","valign":"top","lineHeight":1.25},{"id":"92CmxjGD","type":"text","x":1593.27,"y":1573.76,"w":229.64,"h":25,"text":"Q3 : fork的内存复制机制","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"K9xqp2Pg","type":"text","x":1648.3,"y":1620.1,"w":497.7,"h":25,"text":"从逻辑上看，fork()让子进程获得父进程内存的独立副本","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"MuJvjSPF","type":"text","x":1646.76,"y":1659.48,"w":385.04,"h":25,"text":"但 Linux 通常不会立即复制全部物理内存。","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"0Jb2oapp","type":"text","x":1645.61,"y":1735.12,"w":319.16,"h":25,"text":"Copy-on-Write（COW，写时复制）","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"DJPCNXa0","type":"text","x":1647.7,"y":1697.45,"w":200,"h":25,"text":"它采用一种优化机制：","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"rEVMCD26","type":"text","x":1639.7,"y":1826.07,"w":125.7,"h":25,"text":"fork() 之前：","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"ZAWzTUVr","type":"text","x":1801.82,"y":1829.23,"w":60,"h":25,"text":"父进程","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"U9mOiSlm","type":"text","x":1828.83,"y":1860.89,"w":5.98,"h":25,"text":"|","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"SFiBUELP","type":"text","x":1826.57,"y":1871.12,"w":10.5,"h":25,"text":"v","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"y9SINeBz","type":"text","x":1781.73,"y":1902.11,"w":101.52,"h":25,"text":"物理内存 A","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"L4RKbo0T","type":"text","x":1638.51,"y":1946.83,"w":125.7,"h":25,"text":"fork() 之后：","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"nKOtppdy","type":"text","x":1763.94,"y":1991.83,"w":148,"h":25,"text":"父进程 ───┐","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"8fhQucnW","type":"text","x":1891.63,"y":2007.58,"w":169.52,"h":25,"text":"├── 物理内存 A","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"HE9VPYcp","type":"text","x":1763.54,"y":2022.46,"w":148,"h":25,"text":"子进程 ───┘","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"Ok7n4evl","type":"text","x":1626.66,"y":2072.54,"w":180,"h":25,"text":"子进程修改内存后：","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"2V2TMJCU","type":"text","x":1763.19,"y":2126.67,"w":277.52,"h":25,"text":"父进程 ───── 物理内存 A","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"MuyqcTFs","type":"text","x":1766.36,"y":2171.16,"w":279.22,"h":25,"text":"子进程 ───── 物理内存 B","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"cvTa5VUGVneoDFwTDKdeI","type":"rectangle","x":1598.77,"y":1795.84,"w":499.74,"h":434.74,"color":"#1e1e1e","bg":"transparent","strokeWidth":1,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"6b5yraoB","type":"text","x":1591.63,"y":2258.2,"w":605.18,"h":125,"text":"1. 父进程调用 fork()。\n2. 父子进程暂时共享相同的物理内存页。\n3. 操作系统将相关内存页设置为写时复制。\n4. 当其中一个进程尝试修改内存时，操作系统才复制对应的内存页。\n5. 两个进程分别拥有独立的修改结果。","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"13NsuuJl","type":"text","x":1571.48,"y":2424,"w":605.34,"h":25,"text":"COW 是操作系统的实现优化，不改变 fork() 所提供的逻辑复制语义","size":20,"color":"#1971c2","align":"left","valign":"top","lineHeight":1.25},{"id":"ANjC4ysBqX-EUbDdeyI0E","type":"rectangle","x":1519.81,"y":-358.11,"w":737.43,"h":2863.77,"color":"#1e1e1e","bg":"transparent","strokeWidth":2,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"myTnU3qjknAqACrYtCMs","type":"rectangle","x":2408,"y":-350,"w":820,"h":2004,"color":"#1e1e1e","bg":"transparent","strokeWidth":2,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"WfNfpzSq","type":"text","x":2468,"y":-319,"w":360,"h":45,"text":"进程树与父子进程关系","size":36,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"emqTLne3","type":"text","x":2468,"y":-236,"w":199.9,"h":25,"text":"Q1 ： 什么是进程树？","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"P72UMi5f","type":"text","x":2468,"y":-203,"w":273.7,"h":25,"text":"进程通过 fork() 创建子进程，","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"Ynf7SZ0r","type":"text","x":2468,"y":-170,"w":300,"h":25,"text":"父子关系不断组合，形成进程树。","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"MsbhesIDA97xZEQR4ULL","type":"rectangle","x":2663,"y":231,"w":70,"h":50,"color":"#1e1e1e","bg":"transparent","strokeWidth":2,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"m6F5ckYv","type":"text","x":2692,"y":243.5,"w":14.14,"h":25,"text":"E","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"gZAFudHdk2HiN9UBwQsd","type":"rectangle","x":2783,"y":231,"w":70,"h":50,"color":"#1e1e1e","bg":"transparent","strokeWidth":2,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"vdnT45NV","type":"text","x":2812,"y":243.5,"w":13.22,"h":25,"text":"F","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"zCvkwHrTAyd9cugIRdts","type":"rectangle","x":2723,"y":111,"w":70,"h":50,"color":"#1e1e1e","bg":"transparent","strokeWidth":2,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"wQ6hlDHl","type":"text","x":2752,"y":123.5,"w":12.58,"h":25,"text":"C","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"ac7c2uw8KSVc9mlzpdhu","type":"rectangle","x":2903,"y":111,"w":70,"h":50,"color":"#1e1e1e","bg":"transparent","strokeWidth":2,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"tiNYlp27","type":"text","x":2932,"y":123.5,"w":15.6,"h":25,"text":"D","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"BtHPH5msat5oVCvyBJAX","type":"rectangle","x":2813,"y":-9,"w":70,"h":50,"color":"#1e1e1e","bg":"transparent","strokeWidth":2,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"4DWTJqfx","type":"text","x":2842,"y":3.5,"w":15.22,"h":25,"text":"B","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"6CjnkWxekWfBZtxKs9Tu","type":"rectangle","x":2813,"y":-129,"w":70,"h":50,"color":"#1e1e1e","bg":"transparent","strokeWidth":2,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"OvtFEu8B","type":"text","x":2842,"y":-116.5,"w":13.52,"h":25,"text":"A","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"MQKCEYguoUAe5AMrDIGE","type":"arrow","x":2848,"y":-79,"w":0,"h":70,"color":"#1e1e1e","strokeWidth":2,"points":[[0,0],[0,70]],"startArrowhead":null,"endArrowhead":"arrow","strokeStyle":"solid"},{"id":"6owanatCTle2jcHRoQ8D","type":"arrow","x":2848,"y":41,"w":90,"h":70,"color":"#1e1e1e","strokeWidth":2,"points":[[0,0],[-90,70]],"startArrowhead":null,"endArrowhead":"arrow","strokeStyle":"solid"},{"id":"S9IbYGKISwJODtUWVUnI","type":"arrow","x":2848,"y":41,"w":90,"h":70,"color":"#1e1e1e","strokeWidth":2,"points":[[0,0],[90,70]],"startArrowhead":null,"endArrowhead":"arrow","strokeStyle":"solid"},{"id":"ZWTWpfZODVM0b5261Uho","type":"arrow","x":2758,"y":161,"w":60,"h":70,"color":"#1e1e1e","strokeWidth":2,"points":[[0,0],[-60,70]],"startArrowhead":null,"endArrowhead":"arrow","strokeStyle":"solid"},{"id":"3FFf9u1xnjuNaGfUVW5c","type":"arrow","x":2758,"y":161,"w":60,"h":70,"color":"#1e1e1e","strokeWidth":2,"points":[[0,0],[60,70]],"startArrowhead":null,"endArrowhead":"arrow","strokeStyle":"solid"},{"id":"bO72CvT36hIMFgfncM5Q","type":"rectangle","x":2468,"y":321,"w":260,"h":98,"color":"#1e1e1e","bg":"transparent","strokeWidth":1,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"k8XK4lgf","type":"text","x":2486,"y":336,"w":80,"h":20,"text":"观察命令：","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"fkm1dpmB","type":"text","x":2486,"y":364,"w":116.3,"h":40,"text":"pstree -p\nps -ef --forest","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"PJ0OriQv","type":"text","x":2468,"y":475,"w":345.36,"h":25,"text":"Q2 ： 父进程退出后，子进程怎么办？","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"fOWDTshZ","type":"text","x":2468,"y":508,"w":211.22,"h":25,"text":"如果父进程 B 先退出，","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"mQaFsCJd","type":"text","x":2468,"y":541,"w":278.1,"h":25,"text":"子进程 C 不会自动挂到 A 下。","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"O3DNI8dy","type":"text","x":2468,"y":574,"w":160.58,"h":25,"text":"C 成为孤儿进程，","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"3hZFQP7O","type":"text","x":2468,"y":607,"w":458.78,"h":25,"text":"内核把它重新托管给 init/systemd 或 subreaper。","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"UTQWfcbd","type":"text","x":2468,"y":640,"w":231,"h":25,"text":"C 的 PPID 会发生变化。","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"cuhfafUZ","type":"text","x":2468,"y":683,"w":340,"h":25,"text":"进程树会随进程创建和退出不断变化。","size":20,"color":"#1971c2","align":"left","valign":"top","lineHeight":1.25},{"id":"khMV2KDx","type":"text","x":2468,"y":720,"w":297.09,"h":40,"text":"B 退出前：A ── B ── C\nB 退出后：A        init/systemd ── C","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"nZApjC8j","type":"text","x":2468,"y":804,"w":280.96,"h":25,"text":"Q3 ： SIGCHLD 信号是什么？","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"y3AKbDIC","type":"text","x":2468,"y":837,"w":537.44,"h":25,"text":"子进程终止或状态变化时，内核会向父进程发送 SIGCHLD。","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"3RB5NiMq","type":"text","x":2468,"y":870,"w":400,"h":25,"text":"父进程可以捕获信号，获知子进程状态变化。","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"laIPRhLFTKO0I0SxcrUS","type":"rectangle","x":2468,"y":917,"w":260,"h":90,"color":"#1e1e1e","bg":"transparent","strokeWidth":1,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"M4vKFzLN","type":"text","x":2486,"y":932,"w":198.19,"h":60,"text":"signal(SIGCHLD, handler);\npid_t pid = fork();\nif (pid == 0) _exit(0);","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"91rnt5gc","type":"text","x":2468,"y":1033,"w":365.95,"h":20,"text":"SIGCHLD 不只表示终止；停止、继续也可能产生。","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"bTP6XIui","type":"text","x":2468,"y":1061,"w":321.04,"h":20,"text":"不能只打印信息，还必须用 waitpid() 回收。","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"tLm6ER9U","type":"text","x":2468,"y":1125,"w":223.06,"h":25,"text":"Q4 ： 如何回收子进程？","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"n3SbVkUO","type":"text","x":2468,"y":1158,"w":453.3,"h":25,"text":"waitpid() 等待指定子进程结束，并获取退出状态。","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"jDMJtbAaVBBPwDp5YGhT","type":"rectangle","x":2468,"y":1205,"w":260,"h":70,"color":"#1e1e1e","bg":"transparent","strokeWidth":1,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"RPMcVzzo","type":"text","x":2486,"y":1220,"w":190.58,"h":40,"text":"int status;\nwaitpid(pid, &status, 0);","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"IHTCnLva","type":"text","x":2468,"y":1293,"w":189.52,"h":60,"text":"- pid：等待哪个子进程\n- &status：接收退出状态\n- 0：阻塞等待","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"7WIe7HUd","type":"text","x":2468,"y":1369.5,"w":236.8,"h":20,"text":"父进程不及时回收 → 僵尸进程。","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"yopunAxf","type":"text","x":2468,"y":1400,"w":368,"h":20,"text":"僵尸进程已经结束，但内核保留部分信息等待回收。","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"UKd4h9r7","type":"text","x":2468,"y":1436,"w":399,"h":25,"text":"fork() 建立父子关系，waitpid() 负责回收。","size":20,"color":"#1971c2","align":"left","valign":"top","lineHeight":1.25},{"id":"Xz55JeahG7YJxsBu4kDP","type":"rectangle","x":2468,"y":1501,"w":700,"h":103,"color":"#1e1e1e","bg":"transparent","strokeWidth":2,"round":true,"fillStyle":"solid","strokeStyle":"solid"},{"id":"rfEmAlEv","type":"text","x":2488,"y":1514,"w":40,"h":25,"text":"小结","size":20,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"o6WokG72","type":"text","x":2488,"y":1547,"w":319.31,"h":20,"text":"fork() 创建子进程  ·  SIGCHLD 通知父进程","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25},{"id":"EMEPmN6a","type":"text","x":2488,"y":1567,"w":327.44,"h":20,"text":"waitpid() 回收子进程  ·  孤儿进程被重新托管","size":16,"color":"#1e1e1e","align":"left","valign":"top","lineHeight":1.25}]}